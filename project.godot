config_version=5
[application]
config/name="Ice Harbor"
run/main_scene="res://Main.tscn"
[display]
window/size/viewport_width=540
window/size/viewport_height=960
window/size/window_width_override=810
window/size/window_height_override=1440
window/dpi/allow_hidpi=true
window/stretch/mode="canvas_items"
window/handheld/orientation=1
window/vsync/vsync_mode=1
[rendering]
anti_aliasing/quality/msaa_3d=2
textures/default_filters/anisotropic_filtering_level=4
scaling_3d/scale=1.0
renderer/rendering_method="gl_compatibility"
environment/defaults/default_clear_color=Color(0.10,0.18,0.26,1)

[physics]
common/physics_ticks_per_second=30
common/physics_interpolation=true
